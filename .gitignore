# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies — root and every workspace package/app.
node_modules/
**/node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs — every workspace.
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
**/.turbo/

# Coverage
coverage/
**/coverage/

# TypeScript
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
**/next-env.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env — never commit secrets.
.env
.env.*
!.env.example
!.env.*.example

# Deploy
.vercel

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Claude memory is local.
.claude/

# AI working notes
ai_context.md

bun.lock