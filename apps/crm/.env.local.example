# Anthropic API key — required for live IR generation (/api/generate, /api/refresh).
# The library never reads this itself; lib/engine.ts passes it to createEngine().
ANTHROPIC_API_KEY=sk-ant-...

# Optional. When set, the engine uses Postgres-backed adapters (cache, profile
# store, usage tracker). Without it, in-memory adapters are used (dev/demo).
# DATABASE_URL=postgres://user:pass@localhost:5432/fluid

# Optional. Protects POST /api/refresh; pass as "Authorization: Bearer <secret>".
# REFRESH_SECRET=change-me
