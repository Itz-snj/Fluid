# LLM Provider — OpenRouter (routes to many models via a single key)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: Choose the model (defaults to google/gemini-2.5-flash)
# Popular options: google/gemini-2.5-flash, anthropic/claude-sonnet-4, openai/gpt-4o
OPENROUTER_MODEL=google/gemini-2.5-flash

# Database (required for full features: chat, suggestions, rollback, telemetry)
DATABASE_URL=postgresql://user:password@localhost:5432/fluid_demo

# Optional: Enable debug logging
DEBUG=false
