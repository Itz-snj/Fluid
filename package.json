{
  "name": "fluid-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "demo-app"
  ],
  "scripts": {
    "dev": "bun --filter='@fluid-app/engine' dev",
    "dev:crm": "bun --filter='@fluid-app/crm' dev",
    "build": "bun --filter='@fluid-app/engine' build",
    "build:crm": "bun --filter='@fluid-app/crm' build",
    "build:packages": "bun --filter='./packages/fluid-core' build && bun --filter='./packages/fluid-engine' build && bun --filter='./packages/fluid-react' build",
    "smoke": "bun --filter='@fluid-app/engine' smoke"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
