{
  "name": "fluid-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter='@fluid-app/engine' dev",
    "build": "bun --filter='@fluid-app/engine' build",
    "smoke": "bun --filter='@fluid-app/engine' smoke"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
