{
  "name": "@fluid-genui/react",
  "version": "0.1.1",
  "description": "React components and hooks for Fluid — FluidProvider, FluidView, FluidChat, and the personalized-UI hook surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Itz-snj/Fluid"
  },
  "homepage": "https://github.com/Itz-snj/Fluid#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SERVER_CONTRACT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@fluid-genui/core": "^0.1.0",
    "@fluid-genui/engine": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
